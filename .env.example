# Supabase Auth / browser configuration. These publishable values are safe to expose with RLS enabled.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-side auth verification and database connection.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# REQUIRED for server-side admin CRUD. Keep in Vercel's server environment only.
# Never prefix this value with VITE_, commit it, or send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# REQUIRED only if you save supplier API credentials in the admin panel.
# Use a long random value and keep it server-side. Existing encrypted supplier credentials
# cannot be decrypted if this key is changed, so store a durable backup securely.
SUPPLIER_CREDENTIALS_ENCRYPTION_KEY=YOUR_LONG_RANDOM_ENCRYPTION_SECRET
